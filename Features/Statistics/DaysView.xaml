<UserControl
    x:Class="WorkLifeBalance.Features.Statistics.DaysView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:WorkLifeBalance.Shared.Icons"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:statistics="clr-namespace:WorkLifeBalance.Features.Statistics"
    d:DataContext="{d:DesignInstance Type=statistics:DaysViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="FilterLabel"
            BasedOn="{StaticResource CaptionText}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!--  0 means any  -->
        <StackPanel
            Margin="0,0,0,8"
            DockPanel.Dock="Top"
            Orientation="Horizontal">
            <TextBlock Style="{StaticResource FilterLabel}" Text="Month" />
            <hc:ComboBox
                Width="56"
                Margin="0,0,12,0"
                ItemsSource="{Binding FilterMonths}"
                SelectedItem="{Binding SelectedMonth}" />
            <TextBlock Style="{StaticResource FilterLabel}" Text="Day" />
            <hc:ComboBox
                Width="56"
                Margin="0,0,12,0"
                ItemsSource="{Binding FilterDays}"
                SelectedItem="{Binding SelectedDay}" />
            <TextBlock Style="{StaticResource FilterLabel}" Text="Year" />
            <hc:ComboBox
                Width="70"
                Margin="0,0,12,0"
                ItemsSource="{Binding FilterYears}"
                SelectedItem="{Binding SelectedYear}" />
            <Button Command="{Binding ApplyFiltersCommand}" Style="{StaticResource ToolbarButtonPrimary}">
                <StackPanel Orientation="Horizontal">
                    <Path
                        Width="10"
                        Height="10"
                        Margin="0,0,6,0"
                        Data="{icons:Phosphor MagnifyingGlassBold}"
                        Fill="White"
                        Stretch="Uniform" />
                    <TextBlock Text="Search" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Button
            Margin="0,10,0,0"
            HorizontalAlignment="Left"
            Command="{Binding ReturnToPreviousPageCommand}"
            Content="Back"
            DockPanel.Dock="Bottom"
            Style="{StaticResource ToolbarButton}" />

        <Border Padding="8,4" Style="{StaticResource InsetCard}">
            <DataGrid ItemsSource="{Binding LoadedData}" Style="{StaticResource Table}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding DateC, StringFormat=MM/dd/yyyy}"
                        ElementStyle="{StaticResource NumberCell}"
                        Header="Date" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding WorkedAmmountC, StringFormat=HH:mm:ss}"
                        ElementStyle="{StaticResource NumberCell}"
                        Header="Worked" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding RestedAmmountC, StringFormat=HH:mm:ss}"
                        ElementStyle="{StaticResource NumberCell}"
                        Header="Rested" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding IdleAmmountC, StringFormat=HH:mm:ss}"
                        ElementStyle="{StaticResource NumberCell}"
                        Header="Idle" />
                    <DataGridTemplateColumn Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Command="{Binding DataContext.ViewDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Height="20"
                                    Style="{StaticResource IconButton}"
                                    Tag="{icons:Phosphor InfoBold}"
                                    ToolTip="Day details" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
