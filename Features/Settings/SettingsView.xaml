<UserControl
    x:Class="WorkLifeBalance.Features.Settings.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="clr-namespace:WorkLifeBalance.Features.Settings"
    d:DataContext="{d:DesignInstance Type=settings:SettingsViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="SettingLabel"
            BasedOn="{StaticResource BodyText}"
            TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <TextBlock
            DockPanel.Dock="Bottom"
            Style="{StaticResource CaptionText}"
            Text="{Binding Version}" />

        <StackPanel>
            <DockPanel Style="{StaticResource SettingRow}">
                <ToggleButton
                    DockPanel.Dock="Right"
                    IsChecked="{Binding StartWithWin}"
                    Style="{StaticResource ToggleButtonSwitch}" />
                <TextBlock Style="{StaticResource SettingLabel}" Text="Start with Windows" />
            </DockPanel>

            <DockPanel Style="{StaticResource SettingRow}">
                <ToggleButton
                    DockPanel.Dock="Right"
                    IsChecked="{Binding MinimizeToTray}"
                    Style="{StaticResource ToggleButtonSwitch}" />
                <TextBlock Style="{StaticResource SettingLabel}" Text="Minimize to tray" />
            </DockPanel>

            <DockPanel Style="{StaticResource SettingRow}" ToolTip="The interval of saving information in minutes">
                <hc:ComboBox
                    Width="64"
                    DockPanel.Dock="Right"
                    ItemsSource="{Binding Numbers}"
                    SelectedItem="{Binding AutoSaveInterval}" />
                <TextBlock Style="{StaticResource SettingLabel}" Text="Save every (minutes)" />
            </DockPanel>

            <DockPanel Style="{StaticResource SettingRow}" ToolTip="The interval of detecting the active background window">
                <hc:ComboBox
                    Width="64"
                    DockPanel.Dock="Right"
                    ItemsSource="{Binding Numbers}"
                    SelectedItem="{Binding AutoDetectInterval}" />
                <TextBlock Style="{StaticResource SettingLabel}" Text="Detect state (seconds)" />
            </DockPanel>

            <DockPanel Style="{StaticResource SettingRow}" ToolTip="The interval checking the mouse position for AFK">
                <hc:ComboBox
                    Width="64"
                    DockPanel.Dock="Right"
                    ItemsSource="{Binding Numbers}"
                    SelectedItem="{Binding AutoDetectIdleInterval}" />
                <TextBlock Style="{StaticResource SettingLabel}" Text="Detect idle (minutes)" />
            </DockPanel>
        </StackPanel>
    </DockPanel>
</UserControl>
