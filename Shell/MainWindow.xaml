<Window
    x:Class="WorkLifeBalance.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:WorkLifeBalance.Shared.Icons"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:WorkLifeBalance.Shell"
    Title="WorkLifeBalance"
    Width="520"
    Height="258"
    d:DataContext="{d:DesignInstance Type=shell:MainViewModel}"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <!--  The row of the current state is highlighted; the state name goes in the Tag  -->
        <Style x:Key="TimeRow" TargetType="Border">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource EnumToBooleanConverter}">
                            <Binding Path="AppState" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="TimeValue"
            BasedOn="{StaticResource NumberText}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TimeLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Md}" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>

        <Style x:Key="TimeIcon" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource AppStateToBrushConverter}}" />
            <Setter Property="Data" Value="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource AppStateToIconConverter}}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="AnimatedGrid" RenderTransformOrigin="0,1">
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Margin="16,10,6,18"
                Padding="10,8,10,10"
                Effect="{StaticResource Shadow.Card}"
                Style="{StaticResource SurfaceCard}">
                <DockPanel>
                    <Grid
                        Margin="2,0,0,8"
                        Background="Transparent"
                        DockPanel.Dock="Top"
                        MouseDown="MoveWindow">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource PanelHeaderText}" Text="WORKLIFEBALANCE" />
                            <Border Margin="10,0,0,0" Style="{StaticResource StatePill}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse
                                        Width="7"
                                        Height="7"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Fill="{Binding AppState, Converter={StaticResource AppStateToBrushConverter}}" />
                                    <TextBlock
                                        FontSize="{StaticResource FontSize.XS}"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        Text="{Binding AppState}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button
                                Command="{Binding OpenViewDataWindowCommand}"
                                Style="{StaticResource IconButton}"
                                Tag="{icons:Phosphor ChartBarBold}"
                                ToolTip="Data" />
                            <Button
                                Command="{Binding OpenOptionsWindowCommand}"
                                Style="{StaticResource IconButton}"
                                Tag="{icons:Phosphor GearSixBold}"
                                ToolTip="Options" />
                            <Button
                                Click="HideWindow"
                                Style="{StaticResource IconButton}"
                                Tag="{icons:Phosphor MinusBold}"
                                ToolTip="Minimize" />
                            <Button
                                Command="{Binding CloseAppCommand}"
                                Style="{StaticResource IconButtonDanger}"
                                Tag="{icons:Phosphor XBold}"
                                ToolTip="Close" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="18,6,0,0" DockPanel.Dock="Bottom">
                        <Button Command="{Binding ToggleForceStateCommand}" Style="{StaticResource ToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Width="11"
                                    Height="11"
                                    Margin="0,0,6,0"
                                    Data="{icons:Phosphor HandBold}"
                                    Fill="{DynamicResource SecondaryTextBrush}"
                                    Stretch="Uniform" />
                                <TextBlock Text="Force state" />
                            </StackPanel>
                        </Button>
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionText}"
                            Text="{Binding DateText}" />
                    </Grid>

                    <StackPanel VerticalAlignment="Center">
                        <Border Style="{StaticResource TimeRow}" Tag="Working">
                            <DockPanel>
                                <Path Style="{StaticResource TimeIcon}" />
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource TimeValue}"
                                    Text="{Binding ElapsedWorkTime, Converter={StaticResource TimeOnlyToStringConverter}}" />
                                <TextBlock Style="{StaticResource TimeLabel}" Text="Worked" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource TimeRow}" Tag="Resting">
                            <DockPanel>
                                <Path Style="{StaticResource TimeIcon}" />
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource TimeValue}"
                                    Text="{Binding ElapsedRestTime, Converter={StaticResource TimeOnlyToStringConverter}}" />
                                <TextBlock Style="{StaticResource TimeLabel}" Text="Rested" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource TimeRow}" Tag="Idle">
                            <DockPanel>
                                <Path Style="{StaticResource TimeIcon}" />
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource TimeValue}"
                                    Text="{Binding ElapsedIdleTime, Converter={StaticResource TimeOnlyToStringConverter}}" />
                                <TextBlock Style="{StaticResource TimeLabel}" Text="Idle" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--  Force State / Force Work panel  -->
            <Border
                Grid.Column="1"
                Margin="0,34,10,34"
                Effect="{StaticResource Shadow.Card}"
                Style="{StaticResource SurfaceCard}"
                Visibility="{Binding MainWindowDetailsService.LoadedPage, Converter={StaticResource NullToVisibilityConverter}}">
                <ContentControl Content="{Binding MainWindowDetailsService.LoadedPage}" />
            </Border>
        </Grid>

        <!--  Collapses the window to this button; colored by the current state  -->
        <ToggleButton
            Width="38"
            Height="38"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Cursor="Hand"
            IsChecked="True"
            ToolTip="Show / hide">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Ellipse
                            x:Name="Disc"
                            Effect="{StaticResource Shadow.Card}"
                            Fill="{Binding AppState, Converter={StaticResource AppStateToBrushConverter}}"
                            Stroke="{DynamicResource RegionBrush}"
                            StrokeThickness="3" />
                        <Path
                            Width="16"
                            Height="16"
                            Data="{Binding AppState, Converter={StaticResource AppStateToIconConverter}}"
                            Fill="White"
                            Stretch="Uniform" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Disc" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
            <ToggleButton.Triggers>
                <EventTrigger RoutedEvent="ToggleButton.Checked">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="AnimatedGrid"
                                Storyboard.TargetProperty="RenderTransform.ScaleX"
                                From="0"
                                To="1"
                                Duration="0:0:0.2" />
                            <DoubleAnimation
                                Storyboard.TargetName="AnimatedGrid"
                                Storyboard.TargetProperty="RenderTransform.ScaleY"
                                From="0"
                                To="1"
                                Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="AnimatedGrid"
                                Storyboard.TargetProperty="RenderTransform.ScaleX"
                                From="1"
                                To="0"
                                Duration="0:0:0.2" />
                            <DoubleAnimation
                                Storyboard.TargetName="AnimatedGrid"
                                Storyboard.TargetProperty="RenderTransform.ScaleY"
                                From="1"
                                To="0"
                                Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </ToggleButton.Triggers>
        </ToggleButton>
    </Grid>
</Window>
